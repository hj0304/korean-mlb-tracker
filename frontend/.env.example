# Sentry (S0-11) — browser + server error tracking.
# NEXT_PUBLIC_ prefix exposes the DSN to the client bundle (required for browser errors).
# Set this in Vercel for prod; leave empty locally to keep Sentry disabled.
NEXT_PUBLIC_SENTRY_DSN=

# Backend API base URL (S1-11). NEXT_PUBLIC_ so client-side data fetching can
# read it. No trailing slash; paths include /api/v1. Defaults to localhost:8000
# (local uvicorn) when unset. Set to the Northflank URL in Vercel for prod.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
