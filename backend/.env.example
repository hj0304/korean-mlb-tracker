# Database — Supabase Session pooler (Seoul, ap-northeast-2)
# Real values in backend/.env (git-ignored). Format:
#   postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-<N>-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Logging
LOG_LEVEL=INFO

# Observability (S0-11)
SENTRY_DSN=
