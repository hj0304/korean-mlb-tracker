# Database — Supabase Session pooler (Seoul, ap-northeast-2)
# Real values in backend/.env (git-ignored). Format:
#   postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-<N>-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Logging
LOG_LEVEL=INFO

# Observability (S0-11)
# Sentry is read straight from the process environment (not via Settings), so it
# stays disabled unless SENTRY_DSN is exported. Set both in Northflank for prod;
# leave empty locally to avoid sending dev errors to Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# CORS (S1-13) — browser origins allowed to call this API (comma-separated).
# Defaults to local Next dev when unset. Set to the Vercel URL(s) in Northflank.
CORS_ALLOW_ORIGINS=http://localhost:3000
